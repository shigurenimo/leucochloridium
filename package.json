{
  "name": "leuco",
  "version": "0.16.0",
  "description": "Self-hosted multi-tenant gateway that runs the Codex app-server as a Slack bot. Bun-only.",
  "keywords": [
    "bot",
    "bun",
    "codex",
    "gateway",
    "slack"
  ],
  "homepage": "https://github.com/shigurenimo/leucochloridium#readme",
  "bugs": {
    "url": "https://github.com/shigurenimo/leucochloridium/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shigurenimo/leucochloridium.git"
  },
  "bin": {
    "leuco": "lib/index.ts"
  },
  "files": [
    "lib/**/*.ts",
    "lib/non-bun-stub.js",
    "!lib/**/*.test.ts",
    "!lib/**/*.bun-test.ts",
    "dist/types/**/*.d.ts",
    "CHANGELOG.md",
    "SECURITY.md",
    "tsconfig.json",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/api.ts",
  "module": "./lib/api.ts",
  "types": "./dist/types/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/api.d.ts",
      "bun": "./lib/api.ts",
      "default": "./lib/non-bun-stub.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types": "rm -rf dist/types && tsc -p tsconfig.types.json && bun run scripts/rewrite-declaration-imports.ts",
    "check": "vp check",
    "dev": "bun run lib/index.ts",
    "package:check": "bun run build:types && publint && bun pm pack --dry-run",
    "prepack": "bun run build:types",
    "test": "vp test run && bun run test:bun",
    "test:bun": "bun test ./lib/events/leuco-event-bus.bun-test.ts",
    "test:coverage": "vp test run --coverage",
    "test:package": "bun run scripts/verify-packed-package.ts",
    "typecheck": "tsc -b --pretty false",
    "verify": "bun run check && bun run typecheck && bun run test && bun run package:check && bun run test:package"
  },
  "dependencies": {
    "@interactive-inc/claude-funnel": "0.67.0",
    "@interactive-inc/flume": "0.10.1",
    "hono": "^4.12.32",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "4.1.10",
    "publint": "0.3.22",
    "typescript": "7.0.2",
    "vite-plus": "0.2.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "postcss": "8.5.23"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
