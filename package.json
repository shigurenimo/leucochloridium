{
  "name": "leuco",
  "version": "0.18.0",
  "description": "One local Codex companion CLI with optional Slack and schedules. Reuses your normal CODEX_HOME. Bun-only.",
  "keywords": [
    "bot",
    "bun",
    "cli",
    "codex",
    "slack"
  ],
  "homepage": "https://github.com/shigurenimo/leucochloridium#readme",
  "bugs": {
    "url": "https://github.com/shigurenimo/leucochloridium/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shigurenimo/leucochloridium.git"
  },
  "bin": {
    "leuco": "lib/index.ts"
  },
  "files": [
    "lib/**/*.ts",
    "lib/non-bun-stub.js",
    "!lib/**/*.test.ts",
    "!lib/**/*.bun-test.ts",
    "dist/types/**/*.d.ts",
    "CHANGELOG.md",
    "SECURITY.md",
    "tsconfig.json",
    "README.md",
    "CLI.md",
    "skills/leuco-cli/SKILL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/api.ts",
  "module": "./lib/api.ts",
  "types": "./dist/types/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/api.d.ts",
      "bun": "./lib/api.ts",
      "default": "./lib/non-bun-stub.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types": "rm -rf dist/types && tsc -p tsconfig.types.json && bun run scripts/rewrite-declaration-imports.ts",
    "check": "vp check",
    "dev": "bun run lib/index.ts",
    "package:check": "bun run build:types && publint && bun pm pack --dry-run",
    "prepare": "bun run build:types",
    "prepack": "bun run build:types",
    "test": "vp test run && bun run test:bun",
    "test:bun": "bun test ./lib/events/leuco-event-log.bun-test.ts",
    "test:coverage": "vp test run --coverage",
    "test:package": "bun run scripts/verify-packed-package.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "verify": "bun run check && bun run docs:check && bun run typecheck && bun run test && bun run test:cli && bun run package:check && bun run test:package",
    "test:cli": "bun run scripts/verify-single-companion.ts && bun run scripts/verify-slack-proxy.ts && bun run scripts/verify-cli-contract.ts && bun run scripts/verify-noninteractive.ts && bun run scripts/verify-maintenance.ts && bun run scripts/verify-reliability.ts && bun run scripts/verify-clipboard.ts && bun run scripts/verify-linked-cli.ts",
    "docs:cli": "bun run scripts/generate-cli-docs.ts",
    "docs:check": "bun run scripts/generate-cli-docs.ts --check"
  },
  "dependencies": {
    "@interactive-inc/flume": "0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@vitest/coverage-v8": "5.0.5",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
